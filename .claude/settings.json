{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -l*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git branch -d *)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git switch *)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git worktree add*)",
      "Bash(git worktree list*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(find /tmp/ai-developer-kit-update*)",
      "Bash(stat *)",
      "Bash(test *)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(echo*)",
      "Bash(pwd)",
      "Bash(which*)",
      "Bash(cd *)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(python3 .claude/hooks/test_*.py)",
      "Bash(gh auth*)",
      "Bash(gh issue create*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr ready*)",
      "Bash(gh label create*)",
      "Bash(gh label list*)",
      "Bash(gh repo view*)",
      "Bash(gh repo clone*)",
      "Bash(.claude/hooks/trash.sh*)",
      "Bash(chmod +x .claude/hooks/*)"
    ],
    "deny": [
      "Bash(git switch --detach*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-write.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-edit.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-edit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/on-stop.sh"
          }
        ]
      }
    ]
  }
}
