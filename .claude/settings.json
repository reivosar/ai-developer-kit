{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -l*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -d *)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git checkout -b feat/*)",
      "Bash(git checkout -b fix/*)",
      "Bash(git checkout -b docs/*)",
      "Bash(git checkout -b chore/*)",
      "Bash(git checkout -b refactor/*)",
      "Bash(git checkout -b test/*)",
      "Bash(git checkout -b perf/*)",
      "Bash(git checkout main)",
      "Bash(git switch feat/*)",
      "Bash(git switch fix/*)",
      "Bash(git switch docs/*)",
      "Bash(git switch chore/*)",
      "Bash(git switch refactor/*)",
      "Bash(git switch test/*)",
      "Bash(git switch perf/*)",
      "Bash(git switch -c feat/*)",
      "Bash(git switch -c fix/*)",
      "Bash(git switch -c docs/*)",
      "Bash(git switch -c chore/*)",
      "Bash(git switch -c refactor/*)",
      "Bash(git switch -c test/*)",
      "Bash(git switch -c perf/*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git worktree add*)",
      "Bash(git worktree list*)",
      "Bash(git worktree remove .claude/worktrees/*)",
      "Bash(git worktree prune*)",
      "Bash(.claude/hooks/cleanup-merged-worktrees.sh)",
      "Bash(.claude/hooks/setup-branch-protection.sh)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(stat *)",
      "Bash(test *)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(pwd)",
      "Bash(which*)",
      "Bash(cd *)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run dev*)",
      "Bash(npm run start*)",
      "Bash(python3 *test*.py)",
      "Bash(gh status*)",
      "Bash(gh auth*)",
      "Bash(gh issue create*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr ready*)",
      "Bash(gh label create*)",
      "Bash(gh label list*)",
      "Bash(gh repo view*)",
      "Bash(gh repo clone*)",
      "Bash(cp *)",
      "Bash(.claude/hooks/trash.sh*)",
      "Bash(chmod +x .claude/hooks/*)"
    ],
    "deny": [
      "Bash(git switch --detach*)",
      "Bash(gh label create *--repo*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-bash-check.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-write-check.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-edit-check.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-worktree-check.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-edit-check.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-worktree-check.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-read.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/on-stop.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/cleanup-merged-worktrees.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chmod +x .claude/hooks/*.sh .claude/hooks/*.py"
          }
        ]
      }
    ]
  }
}
