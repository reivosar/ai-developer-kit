{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git pull)",
      "Bash(git pull origin *)",
      "Bash(git pull --ff-only*)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git branch)",
      "Bash(git branch -a*)",
      "Bash(git branch -l*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -d *)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git stash)",
      "Bash(git stash push*)",
      "Bash(git stash apply*)",
      "Bash(git show*)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git remote get-url *)",
      "Bash(git blame*)",
      "Bash(git tag*)",
      "Bash(git worktree list)",
      "Bash(git worktree add .claude/worktrees/*)",
      "Bash(git worktree remove .claude/worktrees/*)",
      "Bash(git checkout -b feat/*)",
      "Bash(git checkout -b fix/*)",
      "Bash(git checkout -b docs/*)",
      "Bash(git checkout -b chore/*)",
      "Bash(git checkout -b refactor/*)",
      "Bash(git checkout -b test/*)",
      "Bash(git checkout -b perf/*)",
      "Bash(git checkout main)",
      "Bash(git switch main)",
      "Bash(git switch feat/*)",
      "Bash(git switch fix/*)",
      "Bash(git switch docs/*)",
      "Bash(git switch chore/*)",
      "Bash(git switch refactor/*)",
      "Bash(git switch test/*)",
      "Bash(git switch perf/*)",
      "Bash(git switch -c feat/*)",
      "Bash(git switch -c fix/*)",
      "Bash(git switch -c docs/*)",
      "Bash(git switch -c chore/*)",
      "Bash(git switch -c refactor/*)",
      "Bash(git switch -c test/*)",
      "Bash(git switch -c perf/*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(stat *)",
      "Bash(test *)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(pwd)",
      "Bash(which*)",
      "Bash(cd *)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run dev*)",
      "Bash(npm run start*)",
      "Bash(python3 *test*.py)",
      "Bash(python3 -m pytest*)",
      "Bash(pytest .claude/hooks/test_*.py*)",
      "Bash(gh status*)",
      "Bash(gh auth status*)",
      "Bash(gh auth login*)",
      "Bash(gh issue create*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue status*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr ready*)",
      "Bash(gh label create*)",
      "Bash(gh label list*)",
      "Bash(gh repo view*)",
      "Bash(gh repo clone*)",
      "Bash(cp *)",
      "Bash(diff *)",
      "Bash(.claude/hooks/trash.sh*)",
      "Bash(.claude/hooks/static-analysis.sh*)",
      "Bash(chmod +x .claude/hooks/*)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(jq *)",
      "Bash(date)",
      "Bash(python3 --version)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(git switch *--detach*)",
      "Bash(gh label create *--repo*)",
      "Bash(cwd)",
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git commit -a*)",
      "Bash(git commit *--all*)",
      "Bash(git commit --amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git pull --force*)",
      "Bash(git pull --rebase*)",
      "Bash(gh auth logout*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-bash.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-write.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/memory_guard.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-edit.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-read.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-mcp.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit.sh"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/memory_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post-tool.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/on-stop.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "chmod +x .claude/hooks/*.sh .claude/hooks/pre-bash.py .claude/hooks/pre-write.py .claude/hooks/pre-edit.py .claude/hooks/user-prompt-submit.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/user-prompt-submit.py"
          }
        ]
      }
    ]
  }
}
